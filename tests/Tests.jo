//[ Tests.jo
  !
  ! The entry point for this agent's suite: `jo test`, or `jo run tests`.
  !
  ! Proves that generated code cannot compile past its capability boundary and
  ! that the runtime refuses a draft the physical facts do not allow.
  ! The HTTP routes are exercised through WSGI, with an echo model for agent
  ! turns. None of these tests needs an API key or the network.
//]

namespace smart.logistics.tests.Main

import jo.IO.stdout
import harpe.logging.Logging
import harpe.logging.logger
import harpe.testing.Testing
import harpe.testing.Runner
import harpe.testing.suite
import harpe.testing.thisSuite
import smart.logistics.tests.DepotTest
import smart.logistics.tests.CapabilityTest
import smart.logistics.tests.ServerTest

def main(): Unit receives stdout =
  Logging.withLogger(Logging.discard, () => run())

private def run(): Unit receives stdout, logger =
  val root = Testing.define("smart-logistics", () => suites())
  val passed = Runner.run(root, Runner.filterFromArgs(), Runner.lanesFromEnv())
  if !passed then py.module("sys").exit(1)
  println ""
  println "all smart-logistics tests passed"

private def suites(): Unit receives thisSuite, logger =
  suite: "depot", () => DepotTest.depotSuite()
  suite: "capability", () => CapabilityTest.capabilitySuite()
  suite: "server", () => ServerTest.serverSuite()
