namespace smart.logistics

import jo.IO.stdout
import harpe.ffi.os
import harpe.ffi.sys
import harpe.util.Process
import harpe.util.File
import harpe.Model
import harpe.server.WebApp
import harpe.server.Route
import smart.logistics.db.DB

param appHome: String

def main(): Unit receives stdout =
  Process.loadDotenv(".env")
  with appHome = os.path.abspath(".") in start()

private def start(): Unit receives stdout, appHome =
  val host = os.getenv("HOST","127.0.0.1")
  if !isLoopback(host) then
    println "Refusing to bind to \{host}: Smart Logistics has no authentication."
    println "Use 127.0.0.1, localhost, or ::1."
    sys.exit(1)

  val dataDir = os.path.join(appHome,"data")
  File.ensureDir(dataDir)
  val databasePath = os.path.join(dataDir,"logistics.db")
  DB.initialize(databasePath, os.path.join(appHome,"migrations"))

  val port = Int.parse(os.getenv("PORT","8766")) rescue None => 8766
  val server = new Server(Model.default(),appHome,databasePath)
  server.startWatching(os.getenv("WATCH_INTERVAL_MINUTES","0"))
  val application = new WebApp:
    routes = [Route.assets("/assets/", os.path.join(appHome, "assets"))]
    fallback = WebApp.Fallback(() => server.route(), maxReqBody = Route.defaultMaxReqBody)
    host = WebApp.Loopback
  val httpd = py.module("waitress").create_server:
    application.wsgi()
    host = host
    port = port
    max_request_body_size = application.maxReqBody

  println """
    Smart Logistics · local depot planner

    Live at http://\{host}:\{port}
    The watcher can only raise warnings. The planner can only draft orders.
    Ctrl-C to stop
  """
  Process.shutdownOnSigint("\nSmart Logistics stopped.")
  httpd.run()

private def isLoopback(host: String): Bool =
  host == "127.0.0.1" || host == "localhost" || host == "::1"
