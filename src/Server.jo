namespace smart.logistics

import harpe.ffi.os
import harpe.ffi.threading
import harpe.util.File
import harpe.Model
import harpe.server.Http.Header
import harpe.server.Http.Mime
import harpe.server.Http.Status
import harpe.server.Request
import harpe.server.Response
import harpe.server.request
import smart.logistics.agents.Watcher
import smart.logistics.agents.Planner
import smart.logistics.db.DB
import smart.logistics.db.conn
import smart.logistics.db.Stock
import smart.logistics.db.Orders
import smart.logistics.db.Checks
import smart.logistics.db.Runs
import smart.logistics.db.Skills
import smart.logistics.db.projectHome

class Server(brain: Model, home: String, databasePath: String)
  private val watcher = new Watcher(brain, home, databasePath)
  private val planner = new Planner(brain, home, databasePath)

  def route(): Response receives request = with projectHome = home in dispatch()

  //[ The routes that need no connection, and then everything else.
    !
    ! The page's own files touch nothing. The two agent routes touch nothing
    ! HERE either — an agent run opens its own connection, because it also
    ! happens on the scheduler's thread where there is no request to inherit
    ! from. Only the tier below is worth a connection, and it opens exactly one.
  //]
  private def dispatch(): Response receives request, projectHome =
    match request
    case Request.Get("/") => asset("index.html", Mime.Html)
    // The watcher, on demand as well as on its schedule.
    case Request.Post("/api/check-now") => Response.json(watcher.run("manual"))
    // The planner, only ever on demand, with this run's note.
    case Request.Post("/api/plan") => plan()
    case _ => DB.withConn(databasePath, () => connected())

  //[ One connection, opened for this request and closed with its response. //]
  private def connected(): Response receives request, conn, projectHome =
    match request
    case Request.Get("/api/snapshot") => snapshot()
    case Request.Get("/api/warnings") =>
      Response.json(py.dict("warnings" ~ Checks.warnings()))
    case Request.Get("/api/checks") =>
      Response.json(py.dict("checks" ~ Checks.checks()))
    case Request.Get("/api/drafts") =>
      Response.json(py.dict("drafts" ~ Orders.drafts()))
    case Request.Get("/api/runs") => Response.json(py.dict("runs" ~ Runs.runs()))
    case Request.Get("/api/demand") =>
      Response.json(py.dict("demand" ~ Stock.demand(28)))
    case Request.Get("/api/movements") => movements()
    case Request.Get("/api/suppliers") =>
      Response.json(py.dict("suppliers" ~ Stock.suppliers()))
    case Request.Get("/api/skills") =>
      Response.json(py.dict("skills" ~ Skills.skillNames()))
    case Request.Get("/api/skills/read") => skillRead()
    case Request.Get("/api/skills/revisions") => skillRevisions()
    case Request.Get("/api/skills/revision") => skillRevision()
    case Request.Get("/api/drafts/export") => draftExport()
    case Request.Post("/api/products") => saveProduct()
    case Request.Post("/api/movements") => recordMovement()
    case Request.Post("/api/checks") => saveCheck()
    case Request.Post("/api/checks/delete") => deleteCheck()
    case Request.Post("/api/skills") => saveSkill()
    case Request.Post("/api/skills/delete") => deleteSkill()
    case Request.Post("/api/drafts/status") => draftStatus()
    case Request.Post("/api/orders/receive") => receiveDelivery()
    case _ => Response.json(py.dict("error" ~ "not found"), status = Status.NotFound)

  //[ Everything the page needs on load, in one response and on one connection.
    !
    ! It used to carry seven counters alongside these, computed in one SELECT.
    ! The page rendered one of them: it derives at-risk, drafts and orders from
    ! the rows below, which it already has. The counter that cost the most was
    ! `at_risk_count`, which walked the whole ledger a second time to produce a
    ! number the page was working out for itself.
  //]
  private def snapshot(): Response receives request, conn =
    Response.json(py.dict:
      "products"  ~ Stock.products()
      "suppliers" ~ Stock.suppliers()
      "summary"   ~ py.dict("last_checked" ~ Runs.lastChecked()))

  //[ Browser responses carry their own headers: nothing is sniffed, and the
    ! page may load only its own script and stylesheet.
  //]
  private def asset(name: String, mime: Mime.Type): Response =
    val headers = List:
      Header:
        "Content-Security-Policy"
        "default-src 'none'; script-src 'self'; style-src 'self'; "
          + "connect-src 'self'; img-src 'self' data:; base-uri 'none'; "
          + "form-action 'none'"
    val body = File.read(os.path.join(home, "assets", name))
    Response.complete(Status.Success, mime, body, headers = headers)

  private def invalidBody(): Response =
    Response.json(py.dict("error" ~ "Expected a JSON object."), status = Status.BadRequest)

  private def query(name: String): String receives request =
    request.query(name).getOrElse("")

  private def ok(extra: py.Dict): Response =
    extra.set("ok", true)
    Response.json(extra)

  private def plan(): Response receives request =
    val data = request.json() rescue None => return invalidBody()
    Response.json(planner.run(data.get("note", "").asString))

  private def saveProduct(): Response receives request, conn =
    val data = request.json() rescue None => return invalidBody()
    ok(py.dict("id" ~ Stock.saveProduct(data)))

  private def movements(): Response receives request, conn =
    val productId = Int.parse(query("product_id")) rescue None => 0
    Response.json(py.dict("movements" ~ Stock.movements(productId, 100)))

  private def recordMovement(): Response receives request, conn =
    val data = request.json() rescue None => return invalidBody()
    ok(py.dict("id" ~ Stock.recordMovement(data)))

  private def saveCheck(): Response receives request, conn =
    val data = request.json() rescue None => return invalidBody()
    ok(py.dict("id" ~ Checks.saveCheck(data)))

  private def deleteCheck(): Response receives request, conn =
    val data = request.json() rescue None => return invalidBody()
    Checks.deleteCheck(data.get("id").asInt)
    ok(py.dict())

  private def skillRead(): Response receives request, projectHome =
    val name = query("name")
    Response.json(py.dict("name" ~ name, "content" ~ Skills.readSkill(name)))

  private def skillRevisions(): Response receives request, conn =
    Response.json(py.dict("revisions" ~ Skills.skillRevisions(query("name"))))

  private def skillRevision(): Response receives request, conn =
    val revision = Int.parse(query("revision")) rescue None => 0
    val name = query("name")
    Response.json: py.dict:
      "name"     ~ name
      "revision" ~ revision
      "content"  ~ Skills.skillRevision(name, revision)

  private def saveSkill(): Response receives request, conn, projectHome =
    val data = request.json() rescue None => return invalidBody()
    val name = Skills.saveSkill:
      data.get("name", "").asString
      data.get("content", "").asString
    ok(py.dict("name" ~ name))

  private def deleteSkill(): Response receives request, projectHome =
    val data = request.json() rescue None => return invalidBody()
    Response.json: py.dict:
      "ok" ~ Skills.deleteSkill(data.get("name", "").asString)

  private def draftStatus(): Response receives request, conn =
    val data = request.json() rescue None => return invalidBody()
    Response.json: py.dict:
      "ok" ~ Orders.setDraftStatus(data.get("id").asInt, data.get("status").asString)

  //[ Booking a delivery against an open order. The only caller is a person at
    ! the receiving door; neither agent has this, or any other, write to stock.
  //]
  private def receiveDelivery(): Response receives request, conn =
    val data = request.json() rescue None => return invalidBody()
    refusable(() => ok(py.dict("received" ~ Orders.receiveOrder(data))))

  //[ A refusal a person can act on.
    !
    ! Everything the depot declines to do — more than the line still owes, past
    ! the capacity of a shelf, against an order that is closed — is declined for
    ! a stated reason, and the person at the receiving door is the one who has
    ! to do something about it. Letting that surface as a bare 500 would tell
    ! them only that the computer said no.
  //]
  private def refusable(handler: () => Response): Response =
    val outcome = py.try: handler()
    match outcome
    case Ok(response) => response
    case Err(error) =>
      Response.json(py.dict("error" ~ error.message), status = Status.BadRequest)

  private def draftExport(): Response receives request, conn =
    val id = Int.parse(query("id")) rescue None => 0
    val selected = py.list()
    for item in Orders.drafts() do
      if item.cast[py.Dict].get("id").asInt == id then selected.append(item)
    Response.json(py.dict("orders" ~ selected))

  //[ The watcher runs on its own. The planner never does. //]
  def startWatching(rawMinutes: String): Unit =
    val minutes = Int.parse(rawMinutes) rescue None => 0
    if minutes <= 0 then return
    val thread = threading.Thread(target = () => schedule(minutes), daemon = true)
    thread.start()

  private def schedule(minutes: Int): Unit =
    while true do
      py.module("time").sleep(minutes * 60)
      val _ = watcher.run("schedule")
end
